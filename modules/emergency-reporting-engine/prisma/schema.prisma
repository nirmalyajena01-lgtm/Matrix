generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Incident {
  id            String @id
  category      String
  description   String
  severity      String
  status        String @default("REPORTED")
  anonymous     Boolean @default(false)
  reporterName  String?
  latitude      Float?
  longitude     Float?
  building      String?
  landmark      String?
  evidenceUrl   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
